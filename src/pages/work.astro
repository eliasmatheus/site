---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';
---

<Base title={`Work · ${site.header.name}`} description="Selected work by Elias Matheus.">
  <main>
    <a href="/">← {site.header.name}</a>
    <h1>Work</h1>
    <p>Selected work is on its way.</p>
  </main>
</Base>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 16px;
  }
</style>
