  /* ---------- Mobile: one vignette per screen, cards stacked ---------- */

  @media (max-width: 767px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'kicker' 'stage' 'skills' 'dialog';
