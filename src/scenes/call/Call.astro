  /* The era tab on the box: the passing of time. */
  .when {
    position: absolute;
    top: 0;
    left: 18px;
    margin: 0;
    padding: 3px 8px;
    background: var(--tab-bg);
    color: var(--tab-ink);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 1.5px;
    text-shadow: none;
    text-transform: uppercase;
    transform: translateY(-60%);
  }

  .line {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.15s steps(2),
      visibility 0s linear 0.15s;
  }

  .line[data-on] {
    opacity: 1;
    visibility: inherit;
    transition: visibility 0s;
  }

  .say {
    margin: 0;
  }

  .say + .say {
    margin-top: 0.35em;
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
