  /* Each line types in letter by letter, like the games did. */
  :global(html.js) .call .ch {
    opacity: 0;
  }

  .line[data-on] .ch {
    animation: type 0s linear calc(var(--i) * 20ms + 0.12s) forwards;
  }

  /* A second line waits for its turn (the controller switches it on). */
  .line[data-on] .late:not([data-on]) .ch {
    animation: none;
  }

  @keyframes type {
    to {
      opacity: 1;
