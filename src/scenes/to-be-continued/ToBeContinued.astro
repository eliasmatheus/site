---
import { site } from '../../content/site';
import { toBeContinued } from '../../content/toBeContinued';
---

<section class="end" data-scene="to-be-continued" aria-labelledby="end-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="copy">
    <p class="kicker">{toBeContinued.kicker}</p>
    <h2 id="end-title">{toBeContinued.title}</h2>
    <p class="text">{toBeContinued.text}</p>
    <a class="cta" href="/work">
      {site.header.work}
    </a>
  </div>
</section>

<style>
  .end {
    background: #0b0d14;
    color: #e6e9f2;
  }

  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, #1b2436, #0b0d14 70%);
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    height: 100%;
    min-height: inherit;
    padding: 96px 24px 64px;
    text-align: center;
  }

  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2px;
    color: #8f9bb8;
  }

  h2 {
    margin: 0;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .text {
    margin: 0;
    max-width: 560px;
    font-size: 18px;
    color: #a9b1c7;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 28px;
    border-radius: 24px;
    background: #e6e9f2;
    color: #0b0d14;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: #fff;
  }
</style>
