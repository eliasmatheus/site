---
/**
 * The fall: after the black hole, the visitor falls down a shaft inside a lattice of
 * streaked beams where the past is a place. Through gaps, glowing windows show moments of
 * the story (newest first); at the bottom waits the first computer. Through the last gap
 * the page becomes that old computer, with a save file ready to continue: The Call.
 *
 * src/scenes/the-fall/controller.ts drives it; world.ts draws the lattice with three.js
 * (loaded on the first interaction). Without WebGL or JS a still gradient stands in and
 * every line stays readable.
 */
import '@fontsource/press-start-2p/latin-400.css';
import { theFall } from '../../content/the-fall';
---

<section class="fall" data-scene="the-fall" aria-labelledby="fall-title">
  <div class="still" aria-hidden="true"></div>
  <canvas class="gl" data-gl role="img" aria-label={theFall.label}></canvas>

  <div class="intro" data-intro>
    <div>
      <h2 id="fall-title">{theFall.title}</h2>
      <p>{theFall.kicker}</p>
    </div>
  </div>

  <p class="glimpse" data-glimpse aria-live="polite">
    {theFall.glimpse}
    <b data-glimpse-text>{theFall.moments[0].label}</b>
  </p>

  <div class="whiteout" data-whiteout aria-hidden="true"></div>

  <div class="retro" data-retro data-screen="0">
    <p class="loading">
      {theFall.retro.loading}
      <span class="cursor" aria-hidden="true"></span>
    </p>
    <div class="save">
      <p class="file">{theFall.retro.save}</p>
      <ul class="menu">
        {theFall.retro.menu.map((m, i) => (
          <li data-pick={i === 0 ? '' : undefined}>{m}</li>
        ))}
      </ul>
      <p class="hint">{theFall.retro.hint}</p>
    </div>
  </div>

  <p class="no-webgl" data-no-webgl hidden>
    {theFall.noWebgl}
  </p>
</section>

<style>
  .fall {
    --phosphor: #b6f3a1;
    --muted: #a39d92;

    overflow: hidden;
    background: #07060a;
    color: #ece7dc;
  }

  /* Before three.js (and without WebGL): a shaft of warm light going down into the dark. */
  .still {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(90deg, rgb(120 82 52 / 0.18) 0 3px, transparent 3px 46px),
      radial-gradient(ellipse 28% 60% at 50% 60%, rgb(255 201 138 / 0.28), transparent 70%),
      linear-gradient(#0b0907, #07060a);
    transition: opacity 1s ease;
  }

  .gl {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .fall[data-ready] .gl {
    opacity: 1;
  }

  .fall[data-ready] .still {
    opacity: 0;
  }

  .whiteout {
    position: absolute;
    inset: 0;
    background: #fff8ee;
    pointer-events: none;
  }

  .intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-inline: 16px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }

  h2 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(36px, 6vw, 80px);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 30px rgb(7 6 10 / 0.9);
    text-wrap: balance;
  }

  .intro p {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #e8a65a;
  }

  .glimpse {
    position: absolute;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
    left: max(16px, 6vw, env(safe-area-inset-left, 0px));
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .glimpse[data-on] {
    opacity: 1;
  }

  .glimpse b {
    display: block;
    margin-top: 4px;
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.6vw, 34px);
    font-style: italic;
    font-weight: 300;
    letter-spacing: 0;
    text-transform: none;
    color: #ece7dc;
  }

  /* ---------- Through the gap: an old computer with a save file ---------- */

  .retro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px max(16px, env(safe-area-inset-right, 0px)) 24px
      max(16px, env(safe-area-inset-left, 0px));
    background: #0b0f0a;
    color: var(--phosphor);
    font-family: 'Press Start 2P', var(--font-mono);
    clip-path: circle(var(--hole, 0%) at 50% 50%);
    pointer-events: none;
  }

  .retro::before,
  .retro::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Scanlines and the curve of the glass. */
  .retro::before {
    background: repeating-linear-gradient(180deg, transparent 0 2px, rgb(0 0 0 / 0.28) 2px 3px);
  }

  .retro::after {
    background: radial-gradient(ellipse at center, rgb(182 243 161 / 0.06), rgb(0 0 0 / 0.75));
  }

  .loading,
  .save {
    grid-area: 1 / 1;
    margin: 0;
    text-shadow: 0 0 6px rgb(182 243 161 / 0.6);
  }

  .loading {
    font-size: clamp(14px, 2vw, 22px);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 0.3em;
    vertical-align: bottom;
    background: var(--phosphor);
    animation: blink 1s steps(2) infinite;
  }

  .save {
    display: grid;
    gap: 20px;
    justify-items: center;
    width: min(520px, 100%);
    opacity: 0;
  }

  .file {
    margin: 0;
    font-size: clamp(11px, 1.4vw, 14px);
    letter-spacing: 1px;
  }

  /* The handheld RPG box The Call opens with: continue where the story was saved. */
  .menu {
    display: grid;
    gap: 14px;
    width: 100%;
    margin: 0;
    padding: 22px 28px;
    list-style: none;
    border: 4px double var(--phosphor);
    border-radius: 8px;
    background: #050805;
    box-shadow: 6px 6px 0 rgb(182 243 161 / 0.25);
    font-size: clamp(12px, 1.5vw, 15px);
    line-height: 1.6;
  }

  .menu li {
    padding-left: 1.6em;
    opacity: 0.55;
  }

  .menu li[data-pick] {
    position: relative;
    opacity: 1;
  }

  .menu li[data-pick]::before {
    content: '▶';
    position: absolute;
    left: 0;
    animation: blink 0.8s steps(2) infinite;
  }

  .hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .retro[data-screen='1'] .loading,
  .retro[data-screen='2'] .loading {
    opacity: 0;
  }

  .retro[data-screen='1'] .save {
    opacity: 1;
  }

  .retro[data-screen='1'] .menu {
    visibility: hidden;
  }

  .retro[data-screen='2'] .save {
    opacity: 1;
  }

  .no-webgl {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 72px);
    left: max(16px, env(safe-area-inset-left, 0px));
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .menu li[data-pick]::before {
      animation: none;
    }
  }

  /* Without JS the scene is a plain section: the title, the moments, the save file. */
  :global(html:not(.js)) .fall .intro {
    position: relative;
    opacity: 1;
    padding-block: 96px 48px;
  }

  :global(html:not(.js)) .fall .whiteout,
  :global(html:not(.js)) .fall .glimpse {
    display: none;
  }

  :global(html:not(.js)) .fall .retro {
    position: relative;
    clip-path: none;
  }

  :global(html:not(.js)) .fall .loading {
    display: none;
  }

  :global(html:not(.js)) .fall .save {
    opacity: 1;
  }
</style>
