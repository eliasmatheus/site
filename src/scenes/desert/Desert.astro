---
import { desert } from '../../content/desert';
---

<section class="desert" data-scene="desert" aria-labelledby="desert-title">
  <img
    class="dunes"
    src="/assets/prologue/dunes-360.webp"
    alt=""
    width="4096"
    height="1024"
    decoding="async"
    loading="lazy"
  />
  <div class="shade" aria-hidden="true"></div>
  <canvas data-sand aria-hidden="true"></canvas>
  <div class="copy">
    <p class="kicker">{desert.kicker}</p>
    <h2 id="desert-title">{desert.title}</h2>
    {desert.paragraphs.map((text, i) => (
      <p class={`line line-${i}`} style={`--at: ${0.15 + i * 0.25}`}>
        {text}
      </p>
    ))}
  </div>
</section>

<style>
  .desert {
    background: #24140a;
    color: #f4e4cc;
  }

  .dunes {
    position: absolute;
    inset: -25% 0 auto;
    width: 100%;
    height: 150%;
    object-fit: cover;
    object-position: 30% 90%;
    filter: sepia(0.45) brightness(0.75);
    transform: translateY(calc(var(--p, 0) * 12%));
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(36 20 10 / 0.55),
      rgb(36 20 10 / 0.1) 40%,
      rgb(36 20 10 / 0.75)
    );
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    min-height: inherit;
    height: 100%;
    padding: 96px 9vw 64px;
  }

  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2px;
    color: #cfb592;
  }

  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(44px, 7vw, 96px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
  }

  .line {
    margin: 0;
    max-width: 640px;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.5;
    /* Each line fades in at its own point of the dwell. Without JS --p is unset: all visible. */
    opacity: clamp(0, calc((var(--p, 1) - var(--at)) * 5), 1);
  }

  .line-1 {
    color: #cfb592;
  }

  /* Mobile: centered, lots of air. */
  @media (max-width: 767px) {
    .copy {
      align-items: center;
      text-align: center;
      gap: 22px;
      padding: 88px 24px 56px;
    }
  }

  /* Reduced motion: no panning. */
  :global([data-mode='fade']) .dunes {
    transform: none;
  }
</style>
