---
import { site } from '../content/site';
import { JOURNEY_QUESTS } from '../engine/quests';

interface Props {
  /** Start hidden: the journey is further down the page. */
  away?: boolean;
}

const { away = false } = Astro.props;
---

<header class="header" data-header data-away={away ? '' : undefined}>
  <a class="name" href="/">
    {site.header.name}
  </a>
  <span class="bar" aria-hidden="true">
    <span class="fill" data-bar></span>
  </span>
  <span class="quests" data-quests aria-live="polite">
    {site.header.quests(0, JOURNEY_QUESTS.length)}
  </span>
  <a class="work" href="/">
    {site.header.work}
  </a>
</header>

<script>
  import { site } from '../content/site';
  import { JOURNEY_QUESTS, loadQuests, QUESTS_EVENT } from '../engine/quests';

  const el = document.querySelector<HTMLElement>('[data-quests]');
  const render = (): void => {
    if (!el) return;
    const done = loadQuests();
    const count = JOURNEY_QUESTS.filter((q) => done.has(q)).length;
    el.textContent = site.header.quests(count, JOURNEY_QUESTS.length);
  };
  render();
  window.addEventListener(QUESTS_EVENT, render);
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: max(8px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 8px
      max(16px, env(safe-area-inset-left));
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      visibility 0s;
  }

  .header[data-away] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-100%);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      visibility 0s linear 0.4s;
  }

  .header a {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  .name {
    font-weight: 500;
    white-space: nowrap;
  }

  .bar {
    flex: 1;
    max-width: 360px;
    height: 2px;
    background: rgb(255 255 255 / 0.25);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: #fff;
    transform-origin: left;
    transform: scaleX(var(--journey, 0));
  }

  .quests {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    white-space: nowrap;
  }

  .work {
    font-size: 15px;
    white-space: nowrap;
  }

  /* Narrow screens: the bar becomes a full-width line under the header. */
  @media (max-width: 480px) {
    .header {
      gap: 12px;
    }
    .bar {
      position: absolute;
      inset: auto 0 0 0;
      max-width: none;
    }
  }

  /* Without the journey script there is no progress to show. */
  :global(html:not(.js)) .bar {
    visibility: hidden;
  }
</style>
